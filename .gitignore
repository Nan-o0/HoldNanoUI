# Build output and caches. Not source - regenerated every build, and .gradle alone is 73MB
# of downloaded Minecraft and library jars that nobody should be pulling from a git clone.
build/
.gradle/

# Editors
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Nothing secret lives in this project today, and this is here so it stays that way. The
# server side - keys, ban lists, player IPs, server.properties - is a separate folder and
# must never end up in here.
*.key
secret*

# Project-local Gradle, 150MB extracted. Fetched by hand because Minecraft 1.21 is
# obfuscated and Loom is the only thing that can remap it; 26.2 builds fine without.
tools/

# The 1.21 source is generated from the 26.2 source by 1.21/port.py, so it is an output and
# not something to edit or commit. Its resources next door are hand written and do belong
# here. Run the script after changing anything under src/.
1.21/src/main/java/

# Extracted from the Minecraft client jar by generators/genreal.py: 161 textures and 467 models
# that Mojang wrote. They are needed to build and they are not ours to publish, so the
# generator is here and its output is not. Run it before building the 1.21 jar.
1.21/src/main/resources/assets/holdsmp/
1.21/src/main/resources/holdsmp-blocks.json
1.21/src/main/resources/holdsmp-statue.json
